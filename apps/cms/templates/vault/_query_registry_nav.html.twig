{# Заглушка: реестр запросов (маршруты позже) #}
{% set query_registry_items = [
    { label: 'Избранное', icon: 'bookmark' },
    { label: 'На главной', icon: 'root' },
    { label: 'В фокусе', icon: 'tag' },
    { label: 'Всегда в контексте', icon: 'inbox' },
    { label: 'Напоминание', icon: 'queue' },
] %}
{% set queryRegistryFilter = 'реестр запросов' %}
{% for item in query_registry_items %}
    {% set queryRegistryFilter = queryRegistryFilter ~ ' ' ~ item.label %}
{% endfor %}
<li role="treeitem" class="hub-tree-zone hub-tree-query-registry" data-hub-tree-zone data-filter-text="{{ queryRegistryFilter|lower|e('html_attr') }}">
    <details class="group/tree" open>
        <summary class="flex cursor-pointer list-none items-center gap-0.5 rounded px-0.5 py-0.5 hover:bg-zinc-50 [&::-webkit-details-marker]:hidden">
            <span class="inline-flex shrink-0 rounded p-0.5 text-zinc-400" aria-hidden="true">
                <svg class="h-3.5 w-3.5 shrink-0 text-zinc-400 transition-transform duration-150 group-open/tree:rotate-90" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>
            </span>
            <span class="flex min-w-0 flex-1 items-center gap-1 rounded px-1 py-0.5 font-medium text-zinc-800">
                {% include 'vault/_hub_tree_icon.html.twig' with {
                    icon: 'queue',
                    icon_class: 'text-violet-500',
                } %}
                <span class="truncate">Реестр запросов</span>
            </span>
        </summary>
        <ul class="ml-3 mt-0.5 space-y-0.5 border-l border-zinc-200 pl-2" role="group">
            {% for item in query_registry_items %}
                {% set itemFilter = item.label|lower %}
                <li role="treeitem" class="hub-tree-node" data-hub-tree-node data-filter-text="{{ itemFilter|e('html_attr') }}">
                    <span class="flex cursor-default items-center gap-1 rounded px-1 py-0.5 text-zinc-400" title="Скоро">
                        {% include 'vault/_hub_tree_icon.html.twig' with {
                            icon: item.icon,
                            icon_class: 'text-zinc-300',
                        } %}
                        <span class="truncate">{{ item.label }}</span>
                    </span>
                </li>
            {% endfor %}
        </ul>
    </details>
</li>