{# vault, disk_folder_path, disk_folder_slot_csrf_id #}
<div class="mt-3 flex flex-col gap-3 border-t border-zinc-100 pt-3">
    <p class="text-xs font-medium uppercase tracking-wide text-zinc-500">Действия в слоте</p>
    <div class="grid gap-3 lg:grid-cols-3">
        <form method="post"
              action="{{ path('vault_disk_slot_create_category', {slug: vault.slug, nodePath: disk_folder_path ~ '~slot-create-category'}) }}"
              class="flex min-w-0 flex-col gap-2 rounded-md border border-zinc-200 bg-zinc-50 px-2.5 py-2">
            <span class="text-xs font-medium text-zinc-900">Создать раздел</span>
            <input type="hidden" name="_token" value="{{ csrf_token(disk_folder_slot_csrf_id) }}">
            <input type="text" name="section_slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*"
                   placeholder="slug"
                   class="w-full rounded-md border border-zinc-200 px-2 py-1.5 font-mono text-xs text-zinc-800">
            <input type="text" name="section_name" required
                   placeholder="Название"
                   class="w-full rounded-md border border-zinc-200 px-2 py-1.5 text-xs text-zinc-800">
            <button type="submit"
                    class="rounded-md border border-zinc-200 bg-white px-2 py-1.5 text-xs font-medium text-zinc-700 hover:bg-zinc-50">
                Создать
            </button>
        </form>

        <form method="post"
              action="{{ path('vault_disk_slot_create_record', {slug: vault.slug, nodePath: disk_folder_path ~ '~slot-create-record'}) }}"
              class="flex min-w-0 flex-col gap-2 rounded-md border border-zinc-200 bg-zinc-50 px-2.5 py-2">
            <span class="text-xs font-medium text-zinc-900">Создать запись</span>
            <input type="hidden" name="_token" value="{{ csrf_token(disk_folder_slot_csrf_id) }}">
            <input type="text" name="record_title" required
                   placeholder="Заголовок"
                   class="w-full rounded-md border border-zinc-200 px-2 py-1.5 text-xs text-zinc-800">
            <input type="text" name="record_slug" pattern="[a-z0-9]+(-[a-z0-9]+)*"
                   placeholder="slug (необяз.)"
                   class="w-full rounded-md border border-zinc-200 px-2 py-1.5 font-mono text-xs text-zinc-800">
            <button type="submit"
                    class="rounded-md border border-zinc-200 bg-white px-2 py-1.5 text-xs font-medium text-zinc-700 hover:bg-zinc-50">
                Создать
            </button>
        </form>

        <form method="post" enctype="multipart/form-data"
              action="{{ path('vault_disk_slot_upload', {slug: vault.slug, nodePath: disk_folder_path ~ '~slot-upload'}) }}"
              class="flex min-w-0 flex-col gap-2 rounded-md border border-zinc-200 bg-zinc-50 px-2.5 py-2">
            <span class="text-xs font-medium text-zinc-900">Загрузить файлы</span>
            <input type="hidden" name="_token" value="{{ csrf_token(disk_folder_slot_csrf_id) }}">
            <input type="file" name="upload_files[]" multiple
                   class="w-full text-xs text-zinc-600 file:mr-2 file:rounded-md file:border file:border-zinc-200 file:bg-white file:px-2 file:py-1 file:text-xs file:font-medium file:text-zinc-700">
            <button type="submit"
                    class="rounded-md border border-zinc-200 bg-white px-2 py-1.5 text-xs font-medium text-zinc-700 hover:bg-zinc-50">
                Загрузить
            </button>
        </form>
    </div>
</div>