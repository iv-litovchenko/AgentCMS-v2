{# Заготовка: быстрая запись в бортовой журнал. Контекст — текущая страница vault. #}
{% set journal_context %}
{%- if disk_file_label|default('') != '' -%}
    {{- disk_file_label -}}
{%- elseif disk_node_label|default('') != '' -%}
    {{- disk_node_label -}}
{%- else -%}
    {%- for crumb in vault_breadcrumbs|default([]) -%}
        {%- if crumb.current|default(false) -%}{{ crumb.label }}{%- endif -%}
    {%- endfor -%}
{%- endif -%}
{% endset %}
{% set journal_context = journal_context|trim %}
{% if journal_context == '' %}
    {% if vault_breadcrumbs|default([])|length > 0 %}
        {% set journal_context = vault_breadcrumbs|last.label|default(vault.name) %}
    {% else %}
        {% set journal_context = vault.name %}
    {% endif %}
{% endif %}
{% set journal_disk_path = active_disk_node_path|default(disk_node_path|default(disk_file_path|default(''))) %}
{% set journal_page_url = app.request.uri %}

<div class="mt-3 border-t border-zinc-100 pt-3">
    <form class="space-y-2" action="#" method="post" aria-labelledby="journal-quick-entry-title" data-journal-quick-stub>
        <h2 id="journal-quick-entry-title" class="text-xs font-medium uppercase tracking-wide text-zinc-500">Запись в журнал</h2>

        <div>
            <label for="journal-quick-context" class="mb-0.5 block text-[11px] font-medium text-zinc-600">Контекст</label>
            <input type="text"
                   id="journal-quick-context"
                   name="journal_context_label"
                   value="{{ journal_context }}"
                   readonly
                   class="w-full rounded-md border border-zinc-200 bg-zinc-50 px-2 py-1.5 text-xs text-zinc-800"
                   title="{{ journal_page_url }}">
            <input type="hidden" name="journal_context_path" value="{{ journal_disk_path }}">
            <input type="hidden" name="journal_context_url" value="{{ journal_page_url }}">
            {% if journal_disk_path != '' %}
                <p class="mt-0.5 truncate font-mono text-[10px] text-zinc-400" title="{{ journal_disk_path }}">{{ journal_disk_path }}</p>
            {% endif %}
        </div>

        <div>
            <label for="journal-quick-event-type" class="mb-0.5 block text-[11px] font-medium text-zinc-600">Тип события</label>
            <select id="journal-quick-event-type"
                    name="journal_event_type"
                    class="w-full rounded-md border border-zinc-200 bg-white px-2 py-1.5 text-xs text-zinc-800">
                <option value="note">Заметка</option>
                <option value="change">Изменение</option>
                <option value="view">Просмотр</option>
                <option value="life">Событие из жизни</option>
                <option value="system">Система</option>
            </select>
        </div>

        <div>
            <label for="journal-quick-summary" class="mb-0.5 block text-[11px] font-medium text-zinc-600">Что произошло</label>
            <textarea id="journal-quick-summary"
                      name="journal_summary"
                      rows="3"
                      placeholder="Кратко…"
                      class="w-full resize-y rounded-md border border-zinc-200 bg-white px-2 py-1.5 text-xs text-zinc-800 placeholder:text-zinc-400"></textarea>
        </div>

        <button type="submit"
                disabled
                class="w-full rounded-md border border-dashed border-zinc-300 bg-zinc-50 px-2 py-1.5 text-xs font-medium text-zinc-400"
                title="Сохранение в журнал — следующий этап">
            Записать (скоро)
        </button>
    </form>
</div>
