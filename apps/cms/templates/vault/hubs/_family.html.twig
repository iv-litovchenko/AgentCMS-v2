{% import _self as family %}

{% macro hub_tile_link(vault, item) %}
    <a href="{{ path('vault_disk_node_show', {slug: vault.slug, nodePath: item.disk_path != '' ? item.disk_path : '_'}) }}"
       class="flex items-center gap-2 rounded-md border border-zinc-200 bg-zinc-50/50 px-2.5 py-2 text-sm hover:border-zinc-300 hover:bg-white"
       title="{{ item.disk_path != '' ? item.disk_path ~ '/' : '' }}{{ item.manifest_file|default('manifest.section.md') }}">
        {% include 'vault/_hub_tree_icon.html.twig' with {
            icon: item.tree_icon|default('folder'),
            icon_class: item.tree_icon_class|default('text-zinc-400'),
        } %}
        <div class="min-w-0 flex-1">
            <span class="block truncate font-medium text-zinc-900">{{ item.name }}</span>
            <span class="mt-0.5 block truncate font-mono text-[11px] text-zinc-500">{{ item.disk_path != '' ? item.disk_path ~ '/' : '' }}{{ item.manifest_file|default('manifest.section.md') }}</span>
        </div>
    </a>
{% endmacro %}

<header class="rounded-lg border border-zinc-200 bg-white px-3 py-3 shadow-sm">
    <h1 class="text-base font-semibold tracking-tight text-zinc-900">{{ hub_group.label }}</h1>
    {% if hub_group.folder|default('') != '' %}
        <p class="mt-0.5 font-mono text-xs text-zinc-500">{{ hub_group.folder }}</p>
    {% endif %}
</header>

{% include 'vault/hubs/_hub_toc_index_button.html.twig' with {
    vault: vault,
    hub_family: hub_family,
    hub_url_zone: hub_url_zone|default(hub_family),
    hub_toc_index_enabled: hub_toc_index_enabled|default(false),
    hub_toc_index_build_csrf_id: hub_toc_index_build_csrf_id|default(''),
} %}

{% if hub_zone_folder_only|default(false) %}
    {% include 'vault/hubs/family/_folder_listing.html.twig' with {
        vault: vault,
        hub_folder_entries: hub_folder_entries|default([]),
    } %}
{% elseif hub_family == 'root' and root_creatable_files|default([])|length > 0 %}
    <section class="rounded-lg border border-zinc-200 bg-white px-3 py-2 shadow-sm">
        <ul class="grid gap-1.5 sm:grid-cols-2 lg:grid-cols-3">
            {% for entry in root_creatable_files %}
                <li>
                    {% if existing_root_files[entry.file]|default(false) %}
                        <a href="{{ path('vault_disk_node_show', {slug: vault.slug, nodePath: entry.file}) }}"
                           class="flex items-center gap-2 rounded-md border border-zinc-200 bg-zinc-50/50 px-2.5 py-2 text-sm hover:border-zinc-300 hover:bg-white">
                            {% include 'vault/_hub_tree_icon.html.twig' with { icon: 'file', icon_class: 'text-zinc-500' } %}
                            <span class="truncate font-medium text-zinc-900">{{ entry.label }}</span>
                        </a>
                    {% else %}
                        <a href="{{ path('vault_module_show', {slug: vault.slug, module: 'create'}) }}?family=root"
                           class="flex items-center gap-2 rounded-md border border-dashed border-zinc-200 px-2.5 py-2 text-sm text-zinc-600 hover:border-zinc-300 hover:bg-zinc-50">
                            {% include 'vault/_hub_tree_icon.html.twig' with { icon: 'file', icon_class: 'text-zinc-400' } %}
                            <span class="truncate">{{ entry.label }}</span>
                        </a>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    </section>
{% else %}
    {% if hub_group.items|default([])|length > 0 %}
        <section class="rounded-lg border border-zinc-200 bg-white px-3 py-2 shadow-sm">
            {% if hub_family|default('') != '' and hub_family != 'root' %}
                <div class="mb-2 flex justify-end">
                    <a href="{{ path('vault_module_show', {slug: vault.slug, module: 'create'}) }}?family={{ hub_family|url_encode }}"
                       class="inline-flex shrink-0 items-center gap-1 rounded-md border border-zinc-200 px-2 py-1 text-xs font-medium text-zinc-600 hover:border-zinc-300 hover:bg-zinc-50 hover:text-zinc-900">
                        <svg class="h-3.5 w-3.5 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                        </svg>
                        Добавить
                    </a>
                </div>
            {% endif %}
            <ul class="grid gap-1.5 sm:grid-cols-2 lg:grid-cols-3">
                {% for item in hub_group.items %}
                    <li>{{ family.hub_tile_link(vault, item) }}</li>
                {% endfor %}
            </ul>
        </section>
    {% else %}
        <section class="rounded-lg border border-dashed border-zinc-200 bg-zinc-50 px-3 py-6 text-center text-sm text-zinc-500 shadow-sm">
            В зоне пока нет узлов.
            <a href="{{ path('vault_module_show', {slug: vault.slug, module: 'create'}) }}?family={{ hub_family }}" class="mt-1 block font-medium text-zinc-800 hover:underline">Создать</a>
        </section>
    {% endif %}
{% endif %}
