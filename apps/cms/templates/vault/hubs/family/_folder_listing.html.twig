<section class="rounded-lg border border-zinc-200 bg-white px-3 py-3 shadow-sm">
    {% if hub_folder_entries|default([])|length == 0 %}
        <p class="text-sm text-zinc-500">Папка пуста.</p>
    {% else %}
        <ul class="divide-y divide-zinc-100 rounded-md border border-zinc-200">
            {% for entry in hub_folder_entries %}
                <li>
                    <a href="{{ path('vault_disk_node_show', {slug: vault.slug, nodePath: entry.disk_path}) }}"
                       class="flex items-center gap-2 px-3 py-2 text-sm hover:bg-zinc-50">
                        {% if entry.is_dir %}
                            {% include 'vault/_hub_tree_icon.html.twig' with { icon: 'folder', icon_class: 'text-zinc-500' } %}
                        {% else %}
                            {% include 'vault/_hub_tree_icon.html.twig' with { icon: 'file', icon_class: 'text-zinc-500' } %}
                        {% endif %}
                        <span class="min-w-0 truncate font-mono text-xs text-zinc-800">{{ entry.name }}{% if entry.is_dir %}/{% endif %}</span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</section>