{# NOTE.md и TODO.md в корне vault — компактно в сайдбаре #}
{% macro root_file_accordion(file_name, title, body, vault) %}
    {% set body_trim = body|default('')|trim %}
    <details class="group/root-md rounded-md border border-zinc-200 bg-zinc-50/50">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-1.5 rounded-md px-2.5 py-2 text-xs font-medium text-zinc-800 hover:bg-zinc-50 [&::-webkit-details-marker]:hidden">
            <span class="truncate">{{ title }}</span>
            <svg class="h-3.5 w-3.5 shrink-0 text-zinc-400 transition group-open/root-md:rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
            </svg>
        </summary>
        <div class="border-t border-zinc-100 px-2.5 py-2">
            {% if body_trim != '' %}
                <pre class="max-h-40 overflow-y-auto whitespace-pre-wrap text-[11px] leading-relaxed text-zinc-700">{{ body_trim }}</pre>
            {% else %}
                <p class="text-[11px] text-zinc-400">Пусто</p>
            {% endif %}
            <a href="{{ path('vault_disk_node_show', {slug: vault.slug, nodePath: file_name}) }}"
               class="mt-1 inline-block text-[10px] font-medium text-zinc-500 hover:text-zinc-800">
                Открыть {{ file_name }}
            </a>
        </div>
    </details>
{% endmacro %}

{% import _self as sidebar_root %}
<div class="mt-2 space-y-2">
    {{ sidebar_root.root_file_accordion('NOTE.md', 'NOTE', sidebar_root_note_body|default(''), vault) }}
    {{ sidebar_root.root_file_accordion('TODO.md', 'TODO', sidebar_root_todo_body|default(''), vault) }}
</div>