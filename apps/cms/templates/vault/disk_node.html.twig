{% extends 'layouts/app.html.twig' %}

{% block title %}{{ disk_node_label }} — {{ vault.name }} — {{ cms_site_title }}{% endblock %}

{% block main %}
    {% embed 'vault/_shell.html.twig' %}
        {% block vault_main %}
            {% include disk_node_view_template with {
                disk_node: disk_node,
                disk_node_path: disk_node_path,
                disk_node_label: disk_node_label,
                disk_node_type_id: disk_node_type_id|default(''),
                vault: vault,
            } %}
        {% endblock %}
    {% endembed %}
{% endblock %}
