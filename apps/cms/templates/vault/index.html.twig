{% extends 'layouts/app.html.twig' %}

{% block title %}Хранилища — {{ cms_site_title }}{% endblock %}

{% block main %}
    <div class="mx-auto flex w-full max-w-6xl flex-1 flex-col gap-4 px-4 py-6 sm:px-6">
        {% for message in app.flashes('success') %}
            <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800" role="alert">
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
                {{ message }}
            </div>
        {% endfor %}

        {% include 'vault/_storages_section.html.twig' with {
            storages: storages,
            is_compact: false,
            vaults_toc_index_build_csrf_id: vaults_toc_index_build_csrf_id|default('vaults_toc_index_build'),
            vaults_catalog_index_exists: vaults_catalog_index_exists|default(false),
        } %}
    </div>
{% endblock %}
