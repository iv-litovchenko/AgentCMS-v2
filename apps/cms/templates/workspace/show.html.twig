{% extends 'layouts/app.html.twig' %}

{% block title %}{{ workspace.name }} — {{ cms_site_title }}{% endblock %}

{% block main %}
    {% embed 'workspace/_shell.html.twig' %}
        {% block workspace_main %}
            <header class="rounded-lg border border-zinc-200 bg-white px-4 py-4 shadow-sm">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                        <h1 class="text-xl font-semibold tracking-tight text-zinc-900">{{ workspace.name }}</h1>
                        {% if workspace.description %}
                            <p class="mt-2 max-w-2xl text-sm text-zinc-600">{{ workspace.description }}</p>
                        {% endif %}
                    </div>
                    <span class="shrink-0 rounded-full px-2.5 py-1 text-xs font-medium {% if workspace.location == 'server' %}bg-blue-50 text-blue-700{% else %}bg-emerald-50 text-emerald-700{% endif %}">
                        {% if workspace.location == 'server' %}сервер{% else %}локально{% endif %}
                    </span>
                </div>
                <p class="mt-3 font-mono text-xs text-zinc-500">{{ workspace.folder }}</p>
                <p class="mt-2 text-xs text-zinc-600">
                    Тип:
                    <span class="font-medium text-zinc-800">{{ type_label }}</span>
                    <span class="font-mono text-zinc-500">({{ workspace.type_id }})</span>
                    {% if type_kind %}
                        <span class="rounded bg-zinc-100 px-1.5 py-0.5 font-mono text-[10px] text-zinc-600">{{ type_kind }}</span>
                    {% endif %}
                </p>
            </header>

            <section class="rounded-lg border border-dashed border-zinc-200 bg-zinc-50 px-4 py-8 text-center text-sm text-zinc-500 shadow-sm">
                Контент хранилища (записи, файлы) — следующий этап.
            </section>
        {% endblock %}
    {% endembed %}
{% endblock %}
