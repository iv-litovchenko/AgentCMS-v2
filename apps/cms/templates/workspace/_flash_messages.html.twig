{% set success_messages = app.flashes('success') %}
{% set error_messages = app.flashes('error') %}
{% if success_messages|length > 0 or error_messages|length > 0 %}
    <div class="flex flex-col gap-2" role="status" aria-live="polite">
        {% for message in success_messages %}
            <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">{{ message }}</div>
        {% endfor %}
        {% for message in error_messages %}
            <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">{{ message }}</div>
        {% endfor %}
    </div>
{% endif %}
