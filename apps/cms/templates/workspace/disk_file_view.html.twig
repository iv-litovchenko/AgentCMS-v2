{% extends 'layouts/app.html.twig' %}

{% block title %}{{ disk_file_label }} — {{ workspace.name }} — {{ cms_site_title }}{% endblock %}

{% block main %}
    {% embed 'workspace/_shell.html.twig' %}
        {% block workspace_main %}
            <section class="rounded-lg border border-zinc-200 bg-white px-4 py-3 shadow-sm">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                        <h1 class="text-lg font-semibold tracking-tight text-zinc-900">{{ disk_file_label }}</h1>
                        <p class="mt-1 font-mono text-[11px] text-zinc-500" title="{{ disk_file_path }}">{{ disk_file_path }}</p>
                        <p class="mt-1 text-xs text-zinc-600">
                            Узел:
                            <a href="{{ path('workspace_disk_node_show', {slug: workspace.slug, nodePath: disk_node_parent_path != '' ? disk_node_parent_path : '_'}) }}"
                               class="font-medium text-zinc-800 hover:underline">
                                {{ disk_node_parent_label }}
                            </a>
                        </p>
                    </div>
                    <div class="flex shrink-0 flex-wrap items-center gap-2">
                        <a href="{{ path('workspace_disk_node_show', {slug: workspace.slug, nodePath: disk_node_parent_path != '' ? disk_node_parent_path : '_'}) }}"
                           class="rounded-md border border-zinc-200 px-2.5 py-1.5 text-xs font-medium text-zinc-600 hover:bg-zinc-50">
                            К узлу
                        </a>
                        <a href="{{ path('workspace_disk_node_edit', {slug: workspace.slug, nodePath: disk_file_path ~ '~edit'}) }}"
                           class="rounded-md border border-zinc-200 px-2.5 py-1.5 text-xs font-medium text-zinc-700 hover:bg-zinc-50">
                            Редактировать
                        </a>
                    </div>
                </div>
                {% if disk_file_edit_mode == 'node_manifest' and disk_file.properties|default([])|length > 0 %}
                    <dl class="mt-3 grid grid-cols-1 gap-x-4 gap-y-2 border-t border-zinc-100 pt-3 text-sm sm:grid-cols-[minmax(8.5rem,10rem)_minmax(0,1fr)]">
                        {% include 'workspace/_frontmatter_dl.html.twig' with {
                            frontmatter_properties: disk_file.properties,
                            hide_acms_type: false,
                            hide_acms_name: false,
                        } %}
                    </dl>
                {% endif %}
            </section>

            <section class="rounded-lg border border-zinc-200 bg-white px-4 py-3 shadow-sm">
                {% if disk_file_edit_mode == 'text' %}
                    <pre class="whitespace-pre-wrap text-sm leading-relaxed text-zinc-800">{{ disk_file_raw|default('') }}</pre>
                {% elseif disk_file_body|default('')|trim != '' %}
                    <pre class="whitespace-pre-wrap text-sm leading-relaxed text-zinc-800">{{ disk_file_body|trim }}</pre>
                {% else %}
                    <p class="text-sm text-zinc-500">Файл пустой.</p>
                {% endif %}
            </section>
        {% endblock %}
    {% endembed %}
{% endblock %}
