{# items, workspace, active_disk_node_path #}
{% import _self as tree %}

{% macro render_nodes(items, workspace, active_disk_node_path) %}
    {% for item in items %}
        {% set diskPath = item.disk_path|default(item.hub_path|default('')) %}
        {% set onDiskNode = active_disk_node_path|default('') == diskPath %}
        {% set itemFilter = (item.name ~ ' ' ~ diskPath)|lower %}
        {% set hasChildren = item.children|default([])|length > 0 %}
        <li role="treeitem" class="hub-tree-node" data-hub-tree-node data-filter-text="{{ itemFilter|e('html_attr') }}">
            {% if hasChildren %}
                <details class="group/node" open>
                    <summary class="flex cursor-pointer list-none items-center gap-1 rounded px-1 py-0.5 hover:bg-zinc-50 [&::-webkit-details-marker]:hidden">
                        <span class="inline-flex shrink-0 text-zinc-400" aria-hidden="true">
                            <svg class="h-3 w-3 transition-transform duration-150 group-open/node:rotate-90" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>
                        </span>
                        {% if onDiskNode %}
                            <span class="flex min-w-0 flex-1 items-center gap-1 rounded bg-zinc-100 px-1 py-0.5 font-medium text-zinc-900">
                                {% include 'workspace/_hub_tree_icon.html.twig' with {
                                    icon: item.tree_icon|default('folder'),
                                    icon_class: item.tree_icon_class|default('text-zinc-400'),
                                } %}
                                <span class="truncate">{{ item.name }}</span>
                            </span>
                        {% else %}
                            <a href="{{ path('workspace_disk_node_show', {slug: workspace.slug, nodePath: diskPath != '' ? diskPath : '_'}) }}"
                               class="flex min-w-0 flex-1 items-center gap-1 rounded px-0.5 py-0.5 text-zinc-600 hover:text-zinc-900"
                               title="{{ diskPath != '' ? diskPath ~ '/' : '' }}{{ item.manifest_file|default('manifest.node.md') }}"
                               onclick="event.stopPropagation()">
                                {% include 'workspace/_hub_tree_icon.html.twig' with {
                                    icon: item.tree_icon|default('folder'),
                                    icon_class: item.tree_icon_class|default('text-zinc-400'),
                                } %}
                                <span class="truncate">{{ item.name }}</span>
                            </a>
                        {% endif %}
                    </summary>
                    <ul class="ml-3 mt-0.5 space-y-0.5 border-l border-zinc-200 pl-2" role="group">
                        {{ _self.render_nodes(item.children, workspace, active_disk_node_path) }}
                    </ul>
                </details>
            {% else %}
                {% if onDiskNode %}
                    <span class="flex items-center gap-1 rounded bg-zinc-100 px-1 py-0.5 font-medium text-zinc-900">
                        {% include 'workspace/_hub_tree_icon.html.twig' with {
                            icon: item.tree_icon|default('folder'),
                            icon_class: item.tree_icon_class|default('text-zinc-400'),
                        } %}
                        <span class="truncate">{{ item.name }}</span>
                    </span>
                {% else %}
                    <a href="{{ path('workspace_disk_node_show', {slug: workspace.slug, nodePath: diskPath != '' ? diskPath : '_'}) }}"
                       class="flex items-center gap-1 rounded px-1 py-0.5 text-zinc-600 hover:bg-zinc-50"
                       title="{{ diskPath != '' ? diskPath ~ '/' : '' }}{{ item.manifest_file|default('manifest.node.md') }}">
                        {% include 'workspace/_hub_tree_icon.html.twig' with {
                            icon: item.tree_icon|default('folder'),
                            icon_class: item.tree_icon_class|default('text-zinc-400'),
                        } %}
                        <span class="truncate">{{ item.name }}</span>
                    </a>
                {% endif %}
            {% endif %}
        </li>
    {% endfor %}
{% endmacro %}

{{ tree.render_nodes(items, workspace, active_disk_node_path|default('')) }}
