<header class="rounded-lg border border-zinc-200 bg-white px-4 py-4 shadow-sm">
    <h1 class="text-xl font-semibold tracking-tight text-zinc-900">{{ hub_label }}</h1>
    <p class="mt-2 font-mono text-xs text-zinc-500">{{ hub_id }}</p>
</header>

<section class="rounded-lg border border-dashed border-zinc-200 bg-zinc-50 px-4 py-8 text-sm text-zinc-600 shadow-sm">
    <p>Экран hub по умолчанию. Шаблон: <code class="rounded bg-white px-1 text-xs">{{ hub_view_template|default('—') }}</code></p>
    {% if hub_type.description is defined %}
        <p class="mt-3 text-zinc-500">{{ hub_type.description }}</p>
    {% endif %}
</section>
