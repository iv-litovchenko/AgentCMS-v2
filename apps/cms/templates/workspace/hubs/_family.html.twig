<header class="rounded-lg border border-zinc-200 bg-white px-4 py-4 shadow-sm">
    <h1 class="text-xl font-semibold tracking-tight text-zinc-900">{{ hub_group.label }}</h1>
    {% if hub_group.folder|default('') != '' %}
        <p class="mt-1 font-mono text-xs text-zinc-500">{{ hub_group.folder }}</p>
    {% endif %}
</header>

<section class="rounded-lg border border-zinc-200 bg-white px-4 py-4 shadow-sm">
    <h2 class="text-sm font-medium text-zinc-900">Типы hub</h2>
    {% if hub_group.items|length > 0 %}
        <ul class="mt-3 space-y-1 text-sm">
            {% for item in hub_group.items %}
                <li>
                    <a href="{{ path('workspace_hub_show', {slug: workspace.slug, hub: item.hub_path}) }}"
                       class="text-zinc-700 hover:text-zinc-900 hover:underline">{{ item.name }}</a>
                    <span class="font-mono text-xs text-zinc-400">hubs/{{ item.hub_path }}</span>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p class="mt-2 text-sm text-zinc-500">Нет зарегистрированных типов в этой семье.</p>
    {% endif %}
    {% if hub_family_base.description is defined %}
        <p class="mt-4 text-sm text-zinc-600">{{ hub_family_base.description }}</p>
    {% endif %}
</section>
