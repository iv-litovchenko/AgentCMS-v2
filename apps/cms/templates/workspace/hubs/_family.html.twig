{% import _self as family %}

{% macro hub_tile_link(workspace, item) %}
    <a href="{{ path('workspace_disk_node_show', {slug: workspace.slug, nodePath: item.disk_path != '' ? item.disk_path : '_'}) }}"
       class="flex items-center gap-2 rounded-md border border-zinc-200 bg-zinc-50/50 px-2.5 py-2 text-sm hover:border-zinc-300 hover:bg-white"
       title="{{ item.disk_path != '' ? item.disk_path ~ '/' : '' }}{{ item.manifest_file|default('manifest.node.md') }}">
        {% include 'workspace/_hub_tree_icon.html.twig' with {
            icon: item.tree_icon|default('folder'),
            icon_class: item.tree_icon_class|default('text-zinc-400'),
        } %}
        <span class="min-w-0 truncate font-medium text-zinc-900">{{ item.name }}</span>
    </a>
{% endmacro %}

<header class="rounded-lg border border-zinc-200 bg-white px-3 py-3 shadow-sm">
    <h1 class="text-base font-semibold tracking-tight text-zinc-900">{{ hub_group.label }}</h1>
    {% if hub_group.folder|default('') != '' %}
        <p class="mt-0.5 font-mono text-xs text-zinc-500">{{ hub_group.folder }}</p>
    {% endif %}
</header>

{% if hub_family == 'root' and root_creatable_files|default([])|length > 0 %}
    <section class="rounded-lg border border-zinc-200 bg-white px-3 py-2 shadow-sm">
        <ul class="grid gap-1.5 sm:grid-cols-2 lg:grid-cols-3">
            {% for entry in root_creatable_files %}
                <li>
                    {% if existing_root_files[entry.file]|default(false) %}
                        <a href="{{ path('workspace_disk_node_show', {slug: workspace.slug, nodePath: entry.file}) }}"
                           class="flex items-center gap-2 rounded-md border border-zinc-200 bg-zinc-50/50 px-2.5 py-2 text-sm hover:border-zinc-300 hover:bg-white">
                            {% include 'workspace/_hub_tree_icon.html.twig' with { icon: 'file', icon_class: 'text-zinc-500' } %}
                            <span class="truncate font-medium text-zinc-900">{{ entry.label }}</span>
                        </a>
                    {% else %}
                        <a href="{{ path('workspace_module_show', {slug: workspace.slug, module: 'create'}) }}?family=root"
                           class="flex items-center gap-2 rounded-md border border-dashed border-zinc-200 px-2.5 py-2 text-sm text-zinc-600 hover:border-zinc-300 hover:bg-zinc-50">
                            {% include 'workspace/_hub_tree_icon.html.twig' with { icon: 'file', icon_class: 'text-zinc-400' } %}
                            <span class="truncate">{{ entry.label }}</span>
                        </a>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    </section>
{% else %}
    {% set known_type_ids = [] %}
    {% for type_item in hub_group.type_items|default([]) %}
        {% set known_type_ids = known_type_ids|merge(['nodes/' ~ type_item.hub_path]) %}
    {% endfor %}
    {% set other_items = hub_group.items|filter(item => item.type_id|default('') == '' or item.type_id|default('') not in known_type_ids) %}

    {% for type_item in hub_group.type_items|default([]) %}
        {% set type_id = 'nodes/' ~ type_item.hub_path %}
        {% set typed_items = hub_group.items|filter(item => item.type_id|default('') == type_id) %}
        {% if typed_items|length > 0 %}
            {% include type_item.family_view_template|default('workspace/hubs/family/_type_section.html.twig') with {
                type_item: type_item,
                typed_items: typed_items,
                workspace: workspace,
                hub_family: hub_family,
                hub_url_zone: hub_url_zone|default(hub_family),
            } %}
        {% endif %}
    {% endfor %}

    {% if other_items|length > 0 %}
        {% include 'workspace/hubs/family/_type_section.html.twig' with {
            type_item: { name: hub_group.label },
            typed_items: other_items,
            workspace: workspace,
            hub_family: hub_family,
            hub_url_zone: hub_url_zone|default(hub_family),
        } %}
    {% endif %}

    {% if hub_group.items|length == 0 %}
        <section class="rounded-lg border border-dashed border-zinc-200 bg-zinc-50 px-3 py-6 text-center text-sm text-zinc-500 shadow-sm">
            В зоне пока нет узлов.
            <a href="{{ path('workspace_module_show', {slug: workspace.slug, module: 'create'}) }}?family={{ hub_family }}" class="mt-1 block font-medium text-zinc-800 hover:underline">Создать</a>
        </section>
    {% endif %}
{% endif %}
