{% for key, value in frontmatter_properties %}
    {% if key starts with 'awn-' and frontmatter_properties[key|acms_frontmatter_key] is defined %}
    {% else %}
        {% set label = key|acms_frontmatter_key %}
        {% set is_type = label == 'acms-type' %}
        {% set is_name = label == 'acms-name' %}
        {% if hide_acms_type|default(false) and is_type %}
        {% elseif hide_acms_name|default(false) and is_name %}
        {% else %}
            <dt class="font-mono text-xs leading-5 text-zinc-500">{{ label }}</dt>
            {% if is_type %}
                <dd class="font-mono text-sm text-zinc-800">{{ value|acms_public_type_id }}</dd>
            {% else %}
                <dd class="text-sm text-zinc-800 break-words">{{ value is iterable ? value|json_encode : value }}</dd>
            {% endif %}
        {% endif %}
    {% endif %}
{% endfor %}
