{% for key, value in frontmatter_properties %}
    {% if key starts with 'awn-' and frontmatter_properties[key|acms_frontmatter_key] is defined %}
    {% else %}
        {% set label = key|acms_frontmatter_key %}
        {% set is_type = label == 'acms-type' %}
        {% set is_name = label == 'acms-name' %}
        {% if hide_acms_type|default(false) and is_type %}
        {% elseif hide_acms_name|default(false) and is_name %}
        {% else %}
            {% set display_value = '' %}
            {% if is_type %}
                {% set display_value = value|acms_public_type_id %}
            {% elseif value is iterable %}
                {% set display_value = value|json_encode %}
            {% else %}
                {% set display_value = value %}
            {% endif %}
            <tr class="align-top hover:bg-zinc-50/80">
                <th scope="row" class="border-r border-zinc-100 bg-zinc-50/60 px-3 py-2 text-left font-mono text-[11px] font-normal leading-snug text-zinc-600">{{ label }}</th>
                {% if display_value|default('')|trim == '' %}
                    <td class="px-3 py-2 text-sm text-zinc-400">—</td>
                {% elseif is_type %}
                    <td class="break-words px-3 py-2 font-mono text-xs text-zinc-800">{{ display_value }}</td>
                {% else %}
                    <td class="break-words px-3 py-2 text-sm leading-snug text-zinc-800">{{ display_value }}</td>
                {% endif %}
            </tr>
        {% endif %}
    {% endif %}
{% endfor %}