{% extends 'layouts/app.html.twig' %}

{% block title %}{{ disk_slot_name }} — {{ workspace.name }} — {{ cms_site_title }}{% endblock %}

{% block main %}
    {% embed 'workspace/_shell.html.twig' %}
        {% block workspace_main %}
            <section class="rounded-lg border border-zinc-200 bg-white px-4 py-4 shadow-sm">
                <div class="flex items-start gap-2">
                    {% if disk_slot_meta.icon|default('') != '' %}
                        <span class="mt-0.5 shrink-0">
                            {% include 'workspace/_hub_tree_icon.html.twig' with {
                                icon: disk_slot_meta.icon|default('folder'),
                                icon_class: disk_slot_meta.icon_class|default('text-zinc-500'),
                            } %}
                        </span>
                    {% endif %}
                    <div class="min-w-0 flex-1">
                        <h1 class="text-sm font-medium text-zinc-900">{{ disk_slot_name }}</h1>
                        <p class="mt-1 font-mono text-[11px] text-zinc-500">{{ disk_slot_path }}</p>
                        <p class="mt-2 text-sm text-zinc-600">Папка слота на диске ещё не создана.</p>
                    </div>
                </div>
                <form class="mt-4" method="post" action="{{ path('workspace_disk_slot_create', {slug: workspace.slug, nodePath: disk_slot_path ~ '~create-slot'}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token(disk_slot_csrf_id) }}">
                    <button type="submit"
                            class="rounded-md border border-zinc-200 bg-white px-3 py-2 text-sm font-medium text-zinc-800 shadow-sm hover:bg-zinc-50">
                        Создать слот
                    </button>
                </form>
            </section>
        {% endblock %}
    {% endembed %}
{% endblock %}
