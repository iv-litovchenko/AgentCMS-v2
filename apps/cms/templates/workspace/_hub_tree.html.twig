{% set onCreate = active_module_slug is defined and active_module_slug == 'create' %}
{% if onCreate %}
    <span class="mb-2 flex items-center gap-2 rounded-md bg-zinc-100 px-2.5 py-1.5 text-sm font-medium text-zinc-900">
        <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-zinc-300" aria-hidden="true"></span>
        Создать
    </span>
{% else %}
    <a href="{{ path('workspace_module_show', {slug: workspace.slug, module: 'create'}) }}"
       class="mb-2 flex items-center gap-2 rounded-md px-2.5 py-1.5 text-sm text-zinc-400 hover:bg-zinc-50 hover:text-zinc-600">
        <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-zinc-300" aria-hidden="true"></span>
        Создать
    </a>
{% endif %}

<nav class="text-xs leading-snug" aria-label="Хабы">
    <ul class="space-y-0.5" role="tree">
        {% for group in hub_tree %}
            {% set onFamily = active_hub_family_page|default(false) and active_hub_family|default('') == group.family %}
            <li role="treeitem" aria-expanded="true">
                {% if onFamily %}
                    <span class="flex items-center gap-1 rounded bg-zinc-100 px-1 py-0.5 font-medium text-zinc-900"
                          {% if group.folder|default('') != '' %}title="{{ group.folder }}"{% endif %}>
                        <svg class="h-3.5 w-3.5 shrink-0 text-zinc-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>
                        {% include 'workspace/_hub_tree_icon.html.twig' with {
                            icon: group.tree_icon|default('folder'),
                            icon_class: group.tree_icon_class|default('text-amber-500'),
                        } %}
                        <span class="truncate">{{ group.label }}</span>
                    </span>
                {% else %}
                    <a href="{{ path('workspace_hub_family_show', {slug: workspace.slug, family: group.family}) }}"
                       class="flex items-center gap-1 rounded px-1 py-0.5 font-medium text-zinc-800 hover:bg-zinc-50"
                       {% if group.folder|default('') != '' %}title="{{ group.folder }}"{% endif %}>
                        <svg class="h-3.5 w-3.5 shrink-0 text-zinc-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>
                        {% include 'workspace/_hub_tree_icon.html.twig' with {
                            icon: group.tree_icon|default('folder'),
                            icon_class: group.tree_icon_class|default('text-amber-500'),
                        } %}
                        <span class="truncate">{{ group.label }}</span>
                    </a>
                {% endif %}
                    <ul class="ml-3 space-y-0.5 border-l border-zinc-200 pl-2" role="group">
                        {% for item in group.items %}
                            <li role="treeitem">
                                {% if item.hub_path == active_hub_path|default('') %}
                                    <span class="flex items-center gap-1 rounded bg-zinc-100 px-1 py-0.5 font-medium text-zinc-900">
                                        <span class="inline-block w-3.5 shrink-0" aria-hidden="true"></span>
                                        <span class="truncate">{{ item.name }}</span>
                                    </span>
                                {% else %}
                                    <a href="{{ path('workspace_hub_show', {slug: workspace.slug, hub: item.hub_path}) }}"
                                       class="flex items-center gap-1 rounded px-1 py-0.5 text-zinc-600 hover:bg-zinc-50">
                                        <span class="inline-block w-3.5 shrink-0" aria-hidden="true"></span>
                                        <span class="truncate">{{ item.name }}</span>
                                    </a>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
            </li>
        {% endfor %}
    </ul>
</nav>
