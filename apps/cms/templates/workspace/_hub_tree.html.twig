{% set onCreate = active_module_slug is defined and active_module_slug == 'create' %}
{% if onCreate %}
    <span class="mb-2 flex items-center gap-2 rounded-md bg-zinc-100 px-2.5 py-1.5 text-sm font-medium text-zinc-900">
        <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-zinc-300" aria-hidden="true"></span>
        Создать
    </span>
{% else %}
    <a href="{{ path('workspace_module_show', {slug: workspace.slug, module: 'create'}) }}"
       class="mb-2 flex items-center gap-2 rounded-md px-2.5 py-1.5 text-sm text-zinc-400 hover:bg-zinc-50 hover:text-zinc-600">
        <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-zinc-300" aria-hidden="true"></span>
        Создать
    </a>
{% endif %}

<nav class="text-xs leading-snug" aria-label="Хабы">
    <ul class="space-y-0.5" role="tree">
        {% for group in hub_tree %}
            {% set onFamily = active_hub_family_page|default(false) and active_hub_family|default('') == group.family %}
            <li role="treeitem">
                <details class="group/hub" open>
                    <summary class="flex cursor-pointer list-none items-center gap-0.5 rounded px-0.5 py-0.5 hover:bg-zinc-50 [&::-webkit-details-marker]:hidden">
                        <span class="inline-flex shrink-0 rounded p-0.5 text-zinc-400" aria-hidden="true">
                            <svg class="h-3.5 w-3.5 shrink-0 transition group-open/hub:rotate-90" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>
                        </span>
                        {% if onFamily %}
                            <span class="flex min-w-0 flex-1 items-center gap-1 rounded bg-zinc-100 px-1 py-0.5 font-medium text-zinc-900"
                                  {% if group.folder|default('') != '' %}title="{{ group.folder }}"{% endif %}>
                                {% include 'workspace/_hub_tree_icon.html.twig' with {
                                    icon: group.tree_icon|default('folder'),
                                    icon_class: group.tree_icon_class|default('text-amber-500'),
                                } %}
                                <span class="truncate">{{ group.label }}</span>
                            </span>
                        {% else %}
                            <a href="{{ path('workspace_hub_family_show', {slug: workspace.slug, family: group.family}) }}"
                               class="flex min-w-0 flex-1 items-center gap-1 rounded px-1 py-0.5 font-medium text-zinc-800 hover:bg-zinc-50"
                               {% if group.folder|default('') != '' %}title="{{ group.folder }}"{% endif %}
                               onclick="event.stopPropagation()">
                                {% include 'workspace/_hub_tree_icon.html.twig' with {
                                    icon: group.tree_icon|default('folder'),
                                    icon_class: group.tree_icon_class|default('text-amber-500'),
                                } %}
                                <span class="truncate">{{ group.label }}</span>
                            </a>
                        {% endif %}
                    </summary>
                    <ul class="ml-3 mt-0.5 space-y-0.5 border-l border-zinc-200 pl-2" role="group">
                        {% for item in group.items %}
                            {% set diskPath = item.disk_path|default(item.hub_path|default('')) %}
                            {% set onDiskNode = active_disk_node_path|default('') == diskPath %}
                            <li role="treeitem">
                                {% if onDiskNode %}
                                    <span class="flex items-center gap-1 rounded bg-zinc-100 px-1 py-0.5 font-medium text-zinc-900">
                                        {% include 'workspace/_hub_tree_icon.html.twig' with {
                                            icon: item.tree_icon|default('folder'),
                                            icon_class: item.tree_icon_class|default('text-zinc-400'),
                                        } %}
                                        <span class="truncate">{{ item.name }}</span>
                                    </span>
                                {% else %}
                                    <a href="{{ path('workspace_disk_node_show', {slug: workspace.slug, nodePath: diskPath != '' ? diskPath : '_'}) }}"
                                       class="flex items-center gap-1 rounded px-1 py-0.5 text-zinc-600 hover:bg-zinc-50"
                                       title="{{ diskPath != '' ? diskPath ~ '/' : '' }}{{ item.manifest_file|default('manifest.node.md') }}">
                                        {% include 'workspace/_hub_tree_icon.html.twig' with {
                                            icon: item.tree_icon|default('folder'),
                                            icon_class: item.tree_icon_class|default('text-zinc-400'),
                                        } %}
                                        <span class="truncate">{{ item.name }}</span>
                                    </a>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </details>
            </li>
        {% endfor %}
    </ul>
</nav>
