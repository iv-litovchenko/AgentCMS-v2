{# workspace_breadcrumbs, workspace_toolbar, workspace #}
{% set toolbar = workspace_toolbar|default({}) %}
{% if workspace_breadcrumbs|default([])|length > 0 %}
    <div class="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-zinc-200 bg-white px-3 py-2 shadow-sm">
        <nav class="min-w-0 flex-1 text-xs text-zinc-600" aria-label="Хлебные крошки">
            <ol class="flex flex-wrap items-center gap-1">
                {% for crumb in workspace_breadcrumbs %}
                    <li class="flex items-center gap-1">
                        {% if not loop.first %}
                            <svg class="h-3 w-3 shrink-0 text-zinc-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>
                        {% endif %}
                        {% if crumb.current|default(false) %}
                            <span class="inline-flex max-w-[14rem] items-center gap-1 truncate rounded-md bg-zinc-100 px-1.5 py-0.5 font-medium text-zinc-900" aria-current="page">
                                {% if crumb.tree_icon|default('') != '' %}
                                    {% include 'workspace/_hub_tree_icon.html.twig' with {
                                        icon: crumb.tree_icon,
                                        icon_class: crumb.tree_icon_class|default('text-zinc-500'),
                                    } %}
                                {% endif %}
                                <span class="truncate">{{ crumb.label }}</span>
                            </span>
                        {% elseif crumb.route|default('') != '' %}
                            <a href="{{ path(crumb.route, crumb.route_params|default({})) }}"
                               class="inline-flex max-w-[12rem] items-center gap-1 truncate rounded-md px-1.5 py-0.5 text-zinc-600 hover:bg-zinc-50 hover:text-zinc-900">
                                {% if crumb.tree_icon|default('') != '' %}
                                    {% include 'workspace/_hub_tree_icon.html.twig' with {
                                        icon: crumb.tree_icon,
                                        icon_class: crumb.tree_icon_class|default('text-zinc-400'),
                                    } %}
                                {% endif %}
                                <span class="truncate">{{ crumb.label }}</span>
                            </a>
                        {% else %}
                            <span class="truncate">{{ crumb.label }}</span>
                        {% endif %}
                    </li>
                {% endfor %}
            </ol>
        </nav>

        <div class="flex shrink-0 items-center gap-0.5 border-l border-zinc-100 pl-1.5" role="toolbar" aria-label="Действия страницы">
            {% include 'workspace/_page_toolbar_button.html.twig' with { action: 'print', workspace: workspace, toolbar: toolbar } %}
            {% include 'workspace/_page_toolbar_button.html.twig' with { action: 'share', workspace: workspace, toolbar: toolbar } %}
            {% if toolbar.reveal_enabled|default(false) %}
                {% include 'workspace/_page_toolbar_button.html.twig' with { action: 'finder', workspace: workspace, toolbar: toolbar } %}
            {% else %}
                {% include 'workspace/_page_toolbar_button.html.twig' with { action: 'finder_disabled', workspace: workspace, toolbar: toolbar } %}
            {% endif %}
            {% include 'workspace/_page_toolbar_button.html.twig' with { action: 'refresh', workspace: workspace, toolbar: toolbar } %}
        </div>
    </div>
{% endif %}

{% include 'workspace/_flash_messages.html.twig' %}
