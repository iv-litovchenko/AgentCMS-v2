{% extends 'layouts/app.html.twig' %}

{% block title %}{{ page_title }} — {{ cms_site_title }}{% endblock %}

{% block main %}
    <main class="mx-auto w-full max-w-2xl flex-1 px-4 py-6 sm:px-6">
        <section class="rounded-lg border border-zinc-200 bg-white p-6 shadow-sm">
            <h1 class="text-xl font-semibold tracking-tight text-zinc-900">{{ page_title }}</h1>

            {{ form_start(form, {attr: {class: 'mt-6 space-y-4', enctype: 'multipart/form-data', novalidate: 'novalidate'}}) }}

            <div>
                {{ form_label(form.name, null, {label_attr: {class: 'mb-1 block text-sm font-medium text-zinc-700'}}) }}
                {{ form_widget(form.name, {attr: {class: 'block w-full rounded-lg border border-zinc-300 bg-zinc-50 px-3 py-2 text-sm text-zinc-900 focus:border-blue-500 focus:ring-blue-500'}}) }}
                {{ form_errors(form.name) }}
            </div>

            <div>
                {{ form_label(form.slug, null, {label_attr: {class: 'mb-1 block text-sm font-medium text-zinc-700'}}) }}
                {{ form_widget(form.slug, {attr: {class: 'block w-full rounded-lg border border-zinc-300 bg-zinc-50 px-3 py-2 font-mono text-sm text-zinc-900 focus:border-blue-500 focus:ring-blue-500'}}) }}
                {% if form.slug.vars.help is not empty %}
                    <p class="mt-1 text-xs text-zinc-500">{{ form.slug.vars.help }}</p>
                {% endif %}
                {{ form_errors(form.slug) }}
            </div>

            <div>
                {{ form_label(form.location, null, {label_attr: {class: 'mb-1 block text-sm font-medium text-zinc-700'}}) }}
                {{ form_widget(form.location, {attr: {class: 'block w-full rounded-lg border border-zinc-300 bg-zinc-50 px-3 py-2 text-sm text-zinc-900 focus:border-blue-500 focus:ring-blue-500'}}) }}
                {{ form_errors(form.location) }}
            </div>

            <div>
                {{ form_label(form.sortOrder, null, {label_attr: {class: 'mb-1 block text-sm font-medium text-zinc-700'}}) }}
                {{ form_widget(form.sortOrder, {attr: {class: 'block w-full max-w-[8rem] rounded-lg border border-zinc-300 bg-zinc-50 px-3 py-2 text-sm text-zinc-900 focus:border-blue-500 focus:ring-blue-500'}}) }}
                <p class="mt-1 text-xs text-zinc-500">Меньшее число — выше в списке.</p>
                {{ form_errors(form.sortOrder) }}
            </div>

            <div>
                {{ form_label(form.avatarUpload, null, {label_attr: {class: 'mb-1 block text-sm font-medium text-zinc-700'}}) }}
                {% if current_avatar is defined and current_avatar %}
                    <div class="mb-2 flex items-center gap-3">
                        {% include 'workspace/_avatar.html.twig' with {avatar: current_avatar, initials: '?', size: 'h-12 w-12'} %}
                        <span class="text-xs text-zinc-500">Текущий аватар · {{ current_avatar }}</span>
                    </div>
                {% endif %}
                {{ form_widget(form.avatarUpload, {attr: {class: 'block w-full cursor-pointer rounded-lg border border-zinc-300 bg-zinc-50 text-sm text-zinc-700 file:mr-4 file:rounded-md file:border-0 file:bg-zinc-200 file:px-3 file:py-2 file:text-sm file:font-medium file:text-zinc-800 hover:file:bg-zinc-300 focus:border-blue-500 focus:ring-blue-500'}}) }}
                <p class="mt-1 text-xs text-zinc-500">JPEG, PNG, GIF или WebP, до 2 МБ.</p>
                {{ form_errors(form.avatarUpload) }}
            </div>

            <div class="flex flex-wrap items-center gap-2 pt-2">
                {{ form_widget(form.save, {attr: {class: 'rounded-lg bg-zinc-900 px-4 py-2 text-sm font-medium text-white hover:bg-zinc-800'}}) }}
                <a href="{{ path('workspace_index') }}"
                   class="rounded-lg border border-zinc-300 bg-white px-4 py-2 text-sm font-medium text-zinc-700 hover:bg-zinc-50">
                    Закрыть
                </a>
            </div>

            {{ form_end(form) }}
        </section>
    </main>
{% endblock %}
