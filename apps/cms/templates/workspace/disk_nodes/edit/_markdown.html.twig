<section class="rounded-lg border border-zinc-200 bg-white px-4 py-4 shadow-sm">
    <p class="text-xs text-zinc-500">Markdown-файл в workspace.</p>
    {% set hasFm = disk_node.properties|default([])|length > 0 %}
    <form method="post" action="{{ app.request.requestUri }}" class="mt-4 space-y-3 text-sm">
        <input type="hidden" name="_token" value="{{ csrf_token(disk_node_edit_csrf_id) }}">
        {% if hasFm %}
            <div>
                <label class="block text-xs font-medium text-zinc-700" for="disk-node-name-md">Имя (frontmatter)</label>
                <input id="disk-node-name-md" name="disk_node_name" type="text" value="{{ disk_node_form_name|e('html_attr') }}"
                       class="mt-1 w-full max-w-lg rounded-md border border-zinc-200 px-2 py-1.5 text-sm">
            </div>
            <div>
                <label class="block text-xs font-medium text-zinc-700" for="disk-node-description-md">Описание</label>
                <textarea id="disk-node-description-md" name="disk_node_description" rows="2"
                          class="mt-1 w-full max-w-lg rounded-md border border-zinc-200 px-2 py-1.5 text-sm">{{ disk_node_form_description }}</textarea>
            </div>
        {% endif %}
        <div>
            <label class="block text-xs font-medium text-zinc-700" for="disk-node-body-md">{% if hasFm %}Тело{% else %}Содержимое{% endif %}</label>
            <textarea id="disk-node-body-md" name="disk_node_body" rows="12" required
                      class="mt-1 w-full font-mono text-xs rounded-md border border-zinc-200 px-2 py-1.5">{% if hasFm %}{{ disk_node_form_body }}{% else %}{{ disk_node_form_body != '' ? disk_node_form_body : disk_node_form_raw }}{% endif %}</textarea>
        </div>
        <button type="submit" class="rounded-md bg-zinc-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-zinc-800">Сохранить</button>
    </form>
</section>
