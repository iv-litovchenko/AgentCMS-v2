{% extends 'layouts/app.html.twig' %}

{% block title %}{{ hub_group.label }} — {{ workspace.name }} — {{ cms_site_title }}{% endblock %}

{% block main %}
    {% embed 'workspace/_shell.html.twig' %}
        {% block workspace_main %}
            {% include 'workspace/hubs/_family.html.twig' with {
                hub_group: hub_group,
                hub_family: hub_family,
                hub_family_base: hub_family_base,
                workspace: workspace,
                root_creatable_files: root_creatable_files|default([]),
                existing_root_files: existing_root_files|default({}),
            } %}
        {% endblock %}
    {% endembed %}
{% endblock %}
