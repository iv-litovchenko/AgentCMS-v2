{% extends 'layouts/app.html.twig' %}

{% block title %}503 — {{ cms_site_title }}{% endblock %}

{% block main %}
<section class="mx-auto flex w-full max-w-6xl flex-1 flex-col justify-center px-4 py-12 sm:px-6">
    <article class="mx-auto w-full max-w-lg rounded-lg border border-zinc-200 bg-white p-6 text-center shadow-sm sm:p-8">
        <p class="text-5xl font-bold tabular-nums text-zinc-300">503</p>
        <h1 class="mt-3 text-xl font-semibold tracking-tight text-zinc-900">Техническое обслуживание</h1>
        <p class="mt-2 text-sm leading-relaxed text-zinc-600">
            {{ message|default('Платформа временно недоступна. Попробуйте позже.') }}
        </p>
    </article>
</section>
{% endblock %}
