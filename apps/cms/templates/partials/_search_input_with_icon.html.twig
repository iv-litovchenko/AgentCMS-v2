{# input_id, placeholder, wrapper_class, input_class, icon_size: sm|md, input_name?, input_value?, disabled?, title? #}
<div class="flex w-full min-w-0 items-center gap-1.5 rounded-md border border-zinc-200 bg-zinc-50 px-2 focus-within:border-blue-500 focus-within:bg-white focus-within:ring-1 focus-within:ring-blue-500 {{ wrapper_class|default('') }}">
    <span class="shrink-0 text-zinc-400" aria-hidden="true">
        {% include 'partials/_icon_search.html.twig' with { size: icon_size|default('md') } %}
    </span>
    <input
        id="{{ input_id }}"
        type="search"
        {% if input_name|default('') != '' %}name="{{ input_name }}"{% endif %}
        {% if input_value is defined %}value="{{ input_value }}"{% endif %}
        placeholder="{{ placeholder }}"
        autocomplete="off"
        {% if disabled|default(false) %}disabled{% endif %}
        {% if title|default('') != '' %}title="{{ title }}"{% endif %}
        class="min-h-0 min-w-0 flex-1 border-0 bg-transparent p-0 shadow-none outline-none ring-0 focus:border-0 focus:outline-none focus:ring-0 appearance-none {{ input_class|default('py-1.5 text-sm text-zinc-900 placeholder:text-zinc-400') }}"
    >
</div>
