<header class="border-b border-zinc-200 bg-white">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-2 sm:px-6">
        <a href="{{ path('home') }}"
           class="flex min-w-0 shrink items-center gap-2 text-sm font-semibold tracking-tight text-zinc-900"
           title="{% if header_quote %}Цитата · {{ cms_site_title }}{% else %}{{ cms_site_title }}{% endif %}">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-zinc-900 text-xs font-bold text-white">A</span>
            <span class="truncate">
                {% if header_quote %}
                    {{ header_quote }}
                {% else %}
                    {{ cms_site_title }}
                {% endif %}
            </span>
        </a>

        <div class="flex flex-wrap items-center justify-end gap-2 sm:gap-3">
            {% set ui_menu_main_has_links = false %}
            {% for item in ui_menu_main %}
                {% if item.type == 'link' and not item.disabled %}
                    {% set ui_menu_main_has_links = true %}
                {% endif %}
            {% endfor %}
            {% if ui_menu_main_has_links %}
                <nav class="flex flex-wrap items-center gap-1 text-sm text-zinc-600" aria-label="Основное">
                    {% for item in ui_menu_main %}
                        {% if item.type == 'link' and not item.disabled %}
                            <a href="{{ item.url }}"
                               class="rounded-md px-2.5 py-1.5 {% if item.active %}font-medium text-zinc-900 bg-zinc-100{% else %}text-zinc-600 hover:bg-zinc-50{% endif %}">
                                {{ item.label }}
                            </a>
                        {% endif %}
                    {% endfor %}
                </nav>

                <div class="hidden h-5 w-px bg-zinc-200 sm:block" aria-hidden="true"></div>
            {% endif %}

            <form class="flex min-w-0 max-w-[14rem] flex-1 items-center sm:max-w-xs" role="search" action="{{ ui_menu_search_url }}" method="get">
                <label for="header-search" class="sr-only">Поиск</label>
                <input
                    id="header-search"
                    type="search"
                    name="q"
                    value="{{ app.request.query.get('q')|default('') }}"
                    placeholder="Поиск…"
                    autocomplete="off"
                    {% if not ui_menu_search_available %}disabled{% endif %}
                    class="w-full rounded-md border border-zinc-200 bg-zinc-50 px-2.5 py-1.5 text-sm text-zinc-900 placeholder:text-zinc-400 focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue-500 disabled:cursor-not-allowed disabled:opacity-70 {% if ui_menu_search_active %}ring-1 ring-blue-500 border-blue-500 bg-white{% endif %}"
                    title="{% if ui_menu_search_available %}Строка поиска по текущему хранилищу{% else %}Сначала создайте хранилище{% endif %}"
                >
            </form>

            <div class="hidden h-5 w-px shrink-0 bg-zinc-200 sm:block" aria-hidden="true"></div>

            <details class="group/apps relative">
                <summary class="flex cursor-pointer list-none items-center gap-1.5 rounded-md border border-transparent px-2 py-1.5 text-sm hover:bg-zinc-50 [&::-webkit-details-marker]:hidden {% if ui_menu_apps_active %}bg-zinc-100 font-medium text-zinc-900{% else %}text-zinc-600{% endif %}">
                    <svg class="h-4 w-4 shrink-0 text-zinc-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z"/>
                    </svg>
                    <span class="hidden sm:inline">Приложения</span>
                    <svg class="h-4 w-4 shrink-0 text-zinc-400 transition group-open/apps:rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                    </svg>
                </summary>
                <div class="absolute right-0 z-50 mt-1 min-w-[11rem] rounded-lg border border-zinc-200 bg-white py-1 text-sm shadow-lg" role="menu" aria-label="Приложения">
                    {% for app in ui_menu_apps %}
                        <a href="{{ app.url }}"
                           role="menuitem"
                           class="block px-3 py-2 {% if app.active %}bg-zinc-100 font-medium text-zinc-900{% else %}text-zinc-700 hover:bg-zinc-50{% endif %}">
                            {{ app.label }}
                        </a>
                    {% endfor %}
                </div>
            </details>

            <details class="group/services relative">
                <summary class="flex cursor-pointer list-none items-center gap-1.5 rounded-md border border-transparent px-2 py-1.5 text-sm hover:bg-zinc-50 [&::-webkit-details-marker]:hidden {% if ui_menu_services_active %}bg-zinc-100 font-medium text-zinc-900{% else %}text-zinc-600{% endif %}">
                    <svg class="h-4 w-4 shrink-0 text-zinc-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3h6.036a3 3 0 0 1 2.121.879l1.06 1.06A3 3 0 0 0 17.964 6H19.5a3 3 0 0 1 3 3v5.25a3 3 0 0 1-3 3H5.25Z"/>
                    </svg>
                    <span class="hidden sm:inline">Сервисы</span>
                    <svg class="h-4 w-4 shrink-0 text-zinc-400 transition group-open/services:rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                    </svg>
                </summary>
                <div class="absolute right-0 z-50 mt-1 min-w-[14rem] rounded-lg border border-zinc-200 bg-white py-1 text-sm shadow-lg" role="menu" aria-label="Сервисы">
                    {% for service in ui_menu_services %}
                        <a href="{{ service.url }}"
                           role="menuitem"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="block px-3 py-2 {% if service.active %}bg-zinc-100 font-medium text-zinc-900{% else %}text-zinc-700 hover:bg-zinc-50{% endif %}">
                            <span class="block">{{ service.label }}</span>
                            <span class="block truncate text-xs font-normal text-zinc-500">{{ service.host }}</span>
                        </a>
                    {% else %}
                        <span class="block px-3 py-2 text-zinc-400">Нет сервисов</span>
                    {% endfor %}
                </div>
            </details>

            <div class="hidden h-5 w-px bg-zinc-200 sm:block" aria-hidden="true"></div>

            <details class="group relative">
                <summary class="flex cursor-pointer list-none items-center gap-2 rounded-md border border-transparent py-1 pl-1 pr-2 text-sm hover:bg-zinc-50 [&::-webkit-details-marker]:hidden">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-zinc-200 text-xs font-semibold text-zinc-700" aria-hidden="true">{{ ui_menu_profile.initials }}</span>
                    <span class="hidden max-w-[8rem] truncate text-left sm:block">
                        <span class="block truncate font-medium text-zinc-900">{{ ui_menu_profile.display_name }}</span>
                        <span class="block truncate text-xs text-zinc-500">{{ ui_menu_profile.email }}</span>
                    </span>
                    <svg class="h-4 w-4 shrink-0 text-zinc-400 transition group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                    </svg>
                </summary>
                <div class="absolute right-0 z-50 mt-1 min-w-[12rem] rounded-lg border border-zinc-200 bg-white py-1 text-sm shadow-lg" role="menu">
                    <div class="border-b border-zinc-100 px-3 py-2 sm:hidden">
                        <p class="truncate font-medium text-zinc-900">{{ ui_menu_profile.display_name }}</p>
                        <p class="truncate text-xs text-zinc-500">{{ ui_menu_profile.email }}</p>
                    </div>
                    {% for item in ui_menu_profile_dropdown %}
                        {% if item.type == 'divider' %}
                            <div class="my-1 border-t border-zinc-100"></div>
                        {% elseif item.disabled %}
                            <span role="menuitem"
                                  class="block cursor-default px-3 py-2 text-zinc-400"
                                  title="Скоро">
                                {{ item.label }}
                            </span>
                        {% else %}
                            <a href="{{ item.url }}"
                               role="menuitem"
                               class="block px-3 py-2 {% if item.active %}bg-zinc-100 font-medium text-zinc-900{% else %}text-zinc-700 hover:bg-zinc-50{% endif %}">
                                {{ item.label }}
                            </a>
                        {% endif %}
                    {% endfor %}
                </div>
            </details>
        </div>
    </div>
</header>
