<header class="border-b border-zinc-200 bg-white">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-2 sm:px-6">
        <a href="{{ path('home') }}"
           class="flex min-w-0 shrink items-center gap-2 text-sm font-semibold tracking-tight text-zinc-900"
           title="{% if header_quote %}Цитата · {{ cms_site_title }}{% else %}{{ cms_site_title }}{% endif %}">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-zinc-900 text-xs font-bold text-white">A</span>
            <span class="truncate">
                {% if header_quote %}
                    {{ header_quote }}
                {% else %}
                    {{ cms_site_title }}
                {% endif %}
            </span>
        </a>

        <div class="flex flex-wrap items-center justify-end gap-2 sm:gap-3">
            {% set ui_menu_main_has_links = false %}
            {% for item in ui_menu_main %}
                {% if item.type == 'link' and not item.disabled %}
                    {% set ui_menu_main_has_links = true %}
                {% endif %}
            {% endfor %}
            {% if ui_menu_main_has_links %}
                <nav class="flex flex-wrap items-center gap-1 text-sm text-zinc-600" aria-label="Основное">
                    {% for item in ui_menu_main %}
                        {% if item.type == 'link' and not item.disabled %}
                            <a href="{{ item.url }}"
                               class="rounded-md px-2.5 py-1.5 {% if item.active %}font-medium text-zinc-900 bg-zinc-100{% else %}text-zinc-600 hover:bg-zinc-50{% endif %}">
                                {{ item.label }}
                            </a>
                        {% endif %}
                    {% endfor %}
                </nav>

                <div class="hidden h-5 w-px bg-zinc-200 sm:block" aria-hidden="true"></div>
            {% endif %}

            <form class="min-w-0 max-w-[14rem] flex-1 sm:max-w-xs" role="search" action="{{ ui_menu_search_url }}" method="get">
                <label for="header-search" class="sr-only">Поиск</label>
                {% include 'partials/_search_input_with_icon.html.twig' with {
                    input_id: 'header-search',
                    input_name: 'q',
                    input_value: app.request.query.get('q')|default(''),
                    placeholder: 'Поиск…',
                    icon_size: 'md',
                    disabled: not ui_menu_search_available,
                    title: ui_menu_search_available ? 'Строка поиска по текущему хранилищу' : 'Сначала создайте хранилище',
                    wrapper_class: (not ui_menu_search_available ? 'opacity-70' : '') ~ (ui_menu_search_active ? ' border-blue-500 bg-white ring-1 ring-blue-500' : '') ~ ' py-1',
                    input_class: 'text-sm text-zinc-900 placeholder:text-zinc-400 disabled:cursor-not-allowed',
                } %}
            </form>

            <div class="hidden h-5 w-px shrink-0 bg-zinc-200 sm:block" aria-hidden="true"></div>

            <details class="group/apps relative">
                <summary class="flex cursor-pointer list-none items-center gap-1.5 rounded-md border border-transparent px-2 py-1.5 text-sm hover:bg-zinc-50 [&::-webkit-details-marker]:hidden {% if ui_menu_apps_active or ui_menu_services_active %}bg-zinc-100 font-medium text-zinc-900{% else %}text-zinc-600{% endif %}">
                    <svg class="h-4 w-4 shrink-0 text-zinc-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z"/>
                    </svg>
                    <span class="hidden sm:inline">Приложения</span>
                    <svg class="h-4 w-4 shrink-0 text-zinc-400 transition group-open/apps:rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                    </svg>
                </summary>
                <div class="absolute right-0 z-50 mt-1 min-w-[14rem] rounded-lg border border-zinc-200 bg-white py-1 text-sm shadow-lg" role="menu" aria-label="Приложения">
                    <details class="group/header-services border-b border-zinc-100">
                        <summary class="flex cursor-pointer list-none items-center justify-between gap-2 px-3 py-2 text-zinc-700 hover:bg-zinc-50 [&::-webkit-details-marker]:hidden {% if ui_menu_services_active %}bg-zinc-50 font-medium text-zinc-900{% endif %}">
                            <span class="flex items-center gap-2">
                                <svg class="h-4 w-4 shrink-0 text-zinc-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3h6.036a3 3 0 0 1 2.121.879l1.06 1.06A3 3 0 0 0 17.964 6H19.5a3 3 0 0 1 3 3v5.25a3 3 0 0 1-3 3H5.25Z"/>
                                </svg>
                                Сервисы
                            </span>
                            <svg class="h-3.5 w-3.5 shrink-0 text-zinc-400 transition group-open/header-services:rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                            </svg>
                        </summary>
                        <div class="border-t border-zinc-50 pb-1" role="group" aria-label="Сервисы">
                            {% for service in ui_menu_services %}
                                <a href="{{ service.url }}"
                                   role="menuitem"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="block px-3 py-2 pl-9 {% if service.active %}bg-zinc-100 font-medium text-zinc-900{% else %}text-zinc-700 hover:bg-zinc-50{% endif %}">
                                    <span class="block">{{ service.label }}</span>
                                    <span class="block truncate text-xs font-normal text-zinc-500">{{ service.host }}</span>
                                </a>
                            {% else %}
                                <span class="block px-3 py-2 pl-9 text-zinc-400">Нет сервисов</span>
                            {% endfor %}
                        </div>
                    </details>
                    {% for app in ui_menu_apps %}
                        <a href="{{ app.url }}"
                           role="menuitem"
                           class="block px-3 py-2 {% if app.active %}bg-zinc-100 font-medium text-zinc-900{% else %}text-zinc-700 hover:bg-zinc-50{% endif %}">
                            {{ app.label }}
                        </a>
                    {% endfor %}
                </div>
            </details>

            <div class="hidden h-5 w-px shrink-0 bg-zinc-200 sm:block" aria-hidden="true"></div>

            <div class="flex items-center gap-0.5">
                <button
                    type="button"
                    id="header-private-data-toggle"
                    class="flex h-8 w-8 items-center justify-center rounded-md border border-transparent text-zinc-500 hover:bg-zinc-50 hover:text-zinc-800 aria-pressed:border-zinc-200 aria-pressed:bg-zinc-100 aria-pressed:text-zinc-900"
                    aria-pressed="true"
                    title="Приватные данные (заготовка)"
                    aria-label="Показывать приватные данные"
                    data-label-on="Скрыть приватные данные"
                    data-label-off="Показывать приватные данные">
                    <svg class="header-private-icon-on h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 0 1-6 0 3 3 0 0 1 6 0Z"/>
                    </svg>
                    <svg class="header-private-icon-off hidden h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88"/>
                    </svg>
                </button>

                <details class="group/notifications relative">
                    <summary class="relative flex h-8 w-8 cursor-pointer list-none items-center justify-center rounded-md border border-transparent text-zinc-500 hover:bg-zinc-50 hover:text-zinc-800 [&::-webkit-details-marker]:hidden"
                             title="Уведомления (заготовка)"
                             aria-label="Уведомления">
                        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0"/>
                        </svg>
                        <span class="absolute right-1.5 top-1.5 h-1.5 w-1.5 rounded-full bg-red-500" aria-hidden="true"></span>
                    </summary>
                    <div class="absolute right-0 z-50 mt-1 w-72 rounded-lg border border-zinc-200 bg-white py-2 text-sm shadow-lg" role="region" aria-label="Уведомления">
                        <p class="border-b border-zinc-100 px-3 pb-2 text-xs font-medium uppercase tracking-wide text-zinc-500">Уведомления</p>
                        <ul class="max-h-64 overflow-y-auto py-1">
                            <li class="px-3 py-2 text-xs text-zinc-500">Новых уведомлений нет.</li>
                        </ul>
                        <p class="border-t border-zinc-100 px-3 pt-2 text-[10px] text-zinc-400">Заготовка — список появится позже.</p>
                    </div>
                </details>
            </div>

            <div class="hidden h-5 w-px shrink-0 bg-zinc-200 sm:block" aria-hidden="true"></div>

            <details class="group relative">
                <summary class="flex cursor-pointer list-none items-center gap-2 rounded-md border border-transparent py-1 pl-1 pr-2 text-sm hover:bg-zinc-50 [&::-webkit-details-marker]:hidden">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-zinc-200 text-xs font-semibold text-zinc-700" aria-hidden="true">{{ ui_menu_profile.initials }}</span>
                    <span class="hidden max-w-[8rem] truncate text-left sm:block">
                        <span class="block truncate font-medium text-zinc-900">{{ ui_menu_profile.display_name }}</span>
                        <span class="block truncate text-xs text-zinc-500">{{ ui_menu_profile.email }}</span>
                    </span>
                    <svg class="h-4 w-4 shrink-0 text-zinc-400 transition group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                    </svg>
                </summary>
                <div class="absolute right-0 z-50 mt-1 min-w-[12rem] rounded-lg border border-zinc-200 bg-white py-1 text-sm shadow-lg" role="menu">
                    <div class="border-b border-zinc-100 px-3 py-2 sm:hidden">
                        <p class="truncate font-medium text-zinc-900">{{ ui_menu_profile.display_name }}</p>
                        <p class="truncate text-xs text-zinc-500">{{ ui_menu_profile.email }}</p>
                    </div>
                    {% for item in ui_menu_profile_dropdown %}
                        {% if item.type == 'divider' %}
                            <div class="my-1 border-t border-zinc-100"></div>
                        {% elseif item.disabled %}
                            <span role="menuitem"
                                  class="block cursor-default px-3 py-2 text-zinc-400"
                                  title="Скоро">
                                {{ item.label }}
                            </span>
                        {% else %}
                            <a href="{{ item.url }}"
                               role="menuitem"
                               class="block px-3 py-2 {% if item.active %}bg-zinc-100 font-medium text-zinc-900{% else %}text-zinc-700 hover:bg-zinc-50{% endif %}">
                                {{ item.label }}
                            </a>
                        {% endif %}
                    {% endfor %}
                </div>
            </details>
        </div>
    </div>
</header>
<script>
(function () {
    var storageKey = 'acms-header-private-data-visible';
    var btn = document.getElementById('header-private-data-toggle');
    if (!btn) {
        return;
    }
    var iconOn = btn.querySelector('.header-private-icon-on');
    var iconOff = btn.querySelector('.header-private-icon-off');
    function applyVisible(visible) {
        btn.setAttribute('aria-pressed', visible ? 'true' : 'false');
        if (visible) {
            btn.setAttribute('aria-label', btn.getAttribute('data-label-on') || '');
            if (iconOn) {
                iconOn.classList.remove('hidden');
            }
            if (iconOff) {
                iconOff.classList.add('hidden');
            }
        } else {
            btn.setAttribute('aria-label', btn.getAttribute('data-label-off') || '');
            if (iconOn) {
                iconOn.classList.add('hidden');
            }
            if (iconOff) {
                iconOff.classList.remove('hidden');
            }
        }
        try {
            localStorage.setItem(storageKey, visible ? '1' : '0');
        } catch (e) {
        }
    }
    var stored = '1';
    try {
        stored = localStorage.getItem(storageKey) || '1';
    } catch (e) {
    }
    applyVisible(stored !== '0');
    btn.addEventListener('click', function () {
        var visible = btn.getAttribute('aria-pressed') !== 'true';
        applyVisible(visible);
    });
})();
</script>
