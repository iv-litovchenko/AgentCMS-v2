<div class="divide-y divide-zinc-200 rounded-xl border border-zinc-200 bg-white p-6 sm:p-8">
    <section id="headings" class="scroll-mt-24 space-y-4 pb-10">
        <h2 class="text-xs font-medium uppercase tracking-wide text-zinc-500">Заголовки</h2>
        <h1 class="text-4xl font-bold text-zinc-900">Heading 1</h1>
        <h2 class="text-3xl font-semibold text-zinc-900">Heading 2</h2>
        <h3 class="text-2xl font-semibold text-zinc-900">Heading 3</h3>
        <h4 class="text-xl font-medium text-zinc-900">Heading 4</h4>
        <h5 class="text-lg font-medium text-zinc-900">Heading 5</h5>
        <h6 class="text-base font-medium text-zinc-900">Heading 6</h6>
    </section>

    <section id="text" class="scroll-mt-24 space-y-4 py-10">
        <h2 class="text-xs font-medium uppercase tracking-wide text-zinc-500">Текст</h2>
        <p class="text-base leading-relaxed text-zinc-700">Paragraph</p>
        <p class="text-lg text-zinc-600">Lead (text-lg)</p>
        <p class="text-sm text-zinc-500">Small / caption (text-sm)</p>
    </section>

    <section id="inline" class="scroll-mt-24 space-y-4 py-10">
        <h2 class="text-xs font-medium uppercase tracking-wide text-zinc-500">В строке</h2>
        <p class="text-base text-zinc-700">
            <strong class="font-semibold">strong</strong>,
            <b>b</b>,
            <em class="italic">em</em>,
            <i class="italic">i</i>,
            <mark class="bg-yellow-200">mark</mark>,
            <u class="underline">u</u>,
            <del class="line-through text-zinc-500">del</del>,
            <ins class="underline">ins</ins>,
            <s class="line-through text-zinc-500">s</s>,
            <sub>sub</sub>,
            <sup>sup</sup>
        </p>
        <p class="text-base text-zinc-700">
            <abbr title="HyperText Markup Language">abbr</abbr>,
            <dfn>dfn</dfn>,
            <cite class="italic">cite</cite>,
            <q>q</q>,
            <time datetime="2026-11-08">time</time>
        </p>
        <p class="text-base text-zinc-700">
            <var class="italic">var</var>,
            <samp class="font-mono text-sm">samp</samp>
        </p>
    </section>

    <section id="link" class="scroll-mt-24 space-y-4 py-10">
        <h2 class="text-xs font-medium uppercase tracking-wide text-zinc-500">Ссылка</h2>
        <p class="text-base text-zinc-700">
            <a href="#" class="text-primary underline hover:opacity-80">a</a>
        </p>
    </section>

    <section id="lists" class="scroll-mt-24 space-y-6 py-10">
        <h2 class="text-xs font-medium uppercase tracking-wide text-zinc-500">Списки</h2>
        <ul class="list-disc space-y-1 pl-5 text-base text-zinc-700">
            <li>ul li</li>
            <li>
                Вложенный ul
                <ul class="mt-1 list-[circle] space-y-1 pl-5">
                    <li>li</li>
                </ul>
            </li>
        </ul>
        <ol class="list-decimal space-y-1 pl-5 text-base text-zinc-700">
            <li>ol li</li>
            <li>ol li</li>
        </ol>
        <dl class="space-y-2 text-base text-zinc-700">
            <dt class="font-medium text-zinc-900">dt</dt>
            <dd class="text-zinc-600">dd</dd>
            <dt class="font-medium text-zinc-900">dt</dt>
            <dd class="text-zinc-600">dd</dd>
        </dl>
    </section>

    <section id="quote" class="scroll-mt-24 space-y-4 py-10">
        <h2 class="text-xs font-medium uppercase tracking-wide text-zinc-500">Цитаты</h2>
        <blockquote cite="#" class="border-l-4 border-zinc-300 pl-4 text-zinc-600">
            blockquote
            <footer class="mt-2 text-sm text-zinc-500">— <cite>footer cite</cite></footer>
        </blockquote>
        <hr class="border-zinc-200">
    </section>

    <section id="address" class="scroll-mt-24 space-y-4 py-10">
        <h2 class="text-xs font-medium uppercase tracking-wide text-zinc-500">Адрес</h2>
        <address class="not-italic text-base leading-relaxed text-zinc-700">
            address<br>
            Line 2
        </address>
    </section>

    <section id="table" class="scroll-mt-24 space-y-4 py-10">
        <h2 class="text-xs font-medium uppercase tracking-wide text-zinc-500">Таблица</h2>
        <table class="w-full border-collapse text-left text-sm text-zinc-700">
            <caption class="mb-2 text-left text-sm text-zinc-500">caption</caption>
            <thead>
                <tr class="border-b border-zinc-200">
                    <th scope="col" class="py-2 pr-4 font-semibold text-zinc-900">th</th>
                    <th scope="col" class="py-2 font-semibold text-zinc-900">th</th>
                </tr>
            </thead>
            <tbody>
                <tr class="border-b border-zinc-100">
                    <td class="py-2 pr-4">td</td>
                    <td class="py-2">td</td>
                </tr>
            </tbody>
            <tfoot>
                <tr class="border-t border-zinc-200 text-zinc-500">
                    <td class="py-2 pr-4" colspan="2">tfoot</td>
                </tr>
            </tfoot>
        </table>
    </section>

    <section id="media" class="scroll-mt-24 space-y-4 py-10">
        <h2 class="text-xs font-medium uppercase tracking-wide text-zinc-500">Медиа</h2>
        <figure>
            <div class="flex h-24 max-w-xs items-center justify-center rounded border border-zinc-200 bg-zinc-50 text-sm text-zinc-500">img</div>
            <figcaption class="mt-2 text-sm text-zinc-500">figcaption</figcaption>
        </figure>
    </section>

    <section id="code" class="scroll-mt-24 space-y-4 py-10">
        <h2 class="text-xs font-medium uppercase tracking-wide text-zinc-500">Код</h2>
        <p class="text-base text-zinc-700">
            <code class="rounded bg-zinc-100 px-1 font-mono text-sm">code</code>
        </p>
        <pre class="overflow-x-auto rounded-lg bg-zinc-900 p-4 text-sm text-zinc-100"><code>pre</code></pre>
        <p class="text-sm text-zinc-600">
            <kbd class="rounded border border-zinc-300 bg-zinc-50 px-1.5 py-0.5 font-mono text-xs">kbd</kbd>
        </p>
    </section>

    <section id="details" class="scroll-mt-24 space-y-4 pt-10">
        <h2 class="text-xs font-medium uppercase tracking-wide text-zinc-500">Раскрытие</h2>
        <details class="rounded border border-zinc-200 px-4 py-3 text-base text-zinc-700">
            <summary class="cursor-pointer font-medium text-zinc-900">summary</summary>
            <p class="mt-2 text-zinc-600">details content</p>
        </details>
    </section>
</div>
